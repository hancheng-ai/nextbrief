#!/bin/sh
# Refuse a push that would publish content copied out of a private directory.
#
# Activate once per clone:
#
#     git config core.hooksPath .githooks
#
# Hooks are not cloned, so this lives in the repository and `core.hooksPath`
# points at it. That makes the check reviewable in a pull request like any other
# code, instead of something each person is trusted to have set up.
#
# Repo-local rather than global on purpose. A global hooks path would apply this
# to every repository on the machine, including ones that legitimately push
# private content to a private remote.
#
# This runs BEFORE the objects leave the machine, which is the whole point. CI
# runs after: by the time a CI job goes red, the data is on a public server, and
# a force-push does not take it back -- unreferenced commits stay retrievable by
# SHA and the public events feed lists those SHAs. CI is the backstop for what
# reaches the remote by another route; this is the fence.
#
# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" on stdin, one
# line per ref being pushed.

set -eu

root="$(git rev-parse --show-toplevel)"
scan="$root/scripts/privacy-scan.py"

if [ ! -f "$scan" ]; then
    echo "pre-push: $scan is missing -- refusing to push." >&2
    echo "          A privacy check that cannot run must not look like one that passed." >&2
    exit 1
fi

# A private directory, when one is configured, turns on the overlap pass -- the
# only pass that catches a borrowed example whose names have been changed.
#
# Its location is deliberately NOT written here. A guard that hardcodes the path
# it is guarding publishes that path, which is the failure this file exists to
# prevent, committed inside the fence itself. So it is read from the
# environment, or from a file outside the repository:
#
#     echo /path/to/your/workspace > ~/.config/nextbrief/private-workspace
#
# Absent, the scan runs its other passes and reports the skip rather than
# passing quietly.
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
pointer="$config_home/nextbrief/private-workspace"
if [ -z "${NEXTBRIEF_PRIVATE_WORKSPACE:-}" ] && [ -f "$pointer" ]; then
    NEXTBRIEF_PRIVATE_WORKSPACE="$(head -n1 "$pointer")"
    export NEXTBRIEF_PRIVATE_WORKSPACE
fi

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # An all-zero local sha is a deletion: nothing is being published.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    if ! python3 "$scan" --range "$remote_sha..$local_sha" \
            ${NEXTBRIEF_PRIVATE_WORKSPACE:+--private-workspace "$NEXTBRIEF_PRIVATE_WORKSPACE"}; then
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    cat >&2 <<'MSG'

pre-push: refusing to push.

Everything above is content this repository must not publish. Fix it in the
commits themselves -- a follow-up commit does not help, because the push
publishes the history, not just the tip.

To override for one push (you had better be certain):

    git push --no-verify
MSG
fi

exit "$status"

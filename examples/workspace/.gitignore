# Generated by scripts/build-example.sh. Not committed: it contains real git
# repositories (which cannot be nested here without submodules) and its value
# depends on file timestamps that only the build script can pin.
projects/

# Generated by a run.
state/
log/

# ...except the stage-2 fixture. It is the recorded output of a model run, not a
# generated file, and committing it is what makes the README's evidence-gate
# demonstration reproducible with `render` alone -- no model, no API key, no
# network. A live `nextbrief run` overwrites it; `git checkout` brings it back.
!state/
state/*
!state/brief.json
BRIEF.md
BRIEF.html

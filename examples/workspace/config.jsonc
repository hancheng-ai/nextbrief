// Example configuration. Identical in shape to nextbrief/templates/config.example.jsonc;
// the only differences are the ones that make a demo readable rather than realistic,
// and each of those is marked DEMO.
{
  "locale": "en",

  "provider": {
    "name": "claude",
    "model": "sonnet",
    "effort": "low"
  },

  "schedule": {
    "slot": "21:30",
    "late_warn_minutes": 360
  },

  "signal": {
    // Pure threshold function. If a model decided these, the same facts would get a
    // different word on different days, and you would stop trusting the word.
    "hot_days": 3,
    "warm_days": 10,
    "cold_days": 30,
    "stale_threshold_days": 21,
    "windows": [1, 7, 30]
  },

  "evidence": {
    "confidence_order": ["commit", "session", "probe", "file_mtime", "doc_declared",
                         "human", "none"],
    "none_allowed_pattern": "no signal"
  },

  "probe": {
    "ttl_days": 7,
    "timeout_seconds": 10
  },

  "scoring": {
    // score = 8*I + U + E -- added, never multiplied, and not configurable.
    // Every number in it is load-bearing for the band arithmetic, and a setting
    // that lets you break a proof is not a setting. `status` gates rather than
    // weighting; `positioning` sets expected dormancy rather than scoring.
  },

  "neglect": {
    // orchard-api has an open decision, so it belongs under "decisions pending".
    // Calling a deliberate pause procrastination is how the system loses your
    // trust -- so it is behaviour, not a setting.
    "default_days": 30
  },

  "caps": {
    // Enforced by the renderer, not by asking the model politely. A "be concise"
    // instruction degrades over time; a renderer that truncates does not.
    "max_next_actions": 3,        // across the WHOLE portfolio. Six projects x 5 items is how these systems die
    "max_waiting_for": 5,
    "max_agent_queue": 3,
    "max_new_items_per_run": 5,   // "new" = not in git HEAD; overflow waits in log/deferred.jsonl
    "max_decision_pending": 3,
    "per_project_line_chars": 140,
    "brief_max_lines": 100
  },

  "limits": {
    "max_open_items_total": 40
  },

  "decay": {
    // An agent may retract its own guesses. It may never retract your commitments.
    "auto_drop_after_days": 60,
    "auto_drop_requires": {
      "created_by_prefix": "nextbrief-",
      "human_confirmed": false,
      "zero_project_evidence": true
    }
  },

  "automation": {
    "tiers": ["explore", "skill", "hook"]
  },

  "notify": {
    // `backend`, not `sink`. The sink layer reads `notify.backend`, so the key
    // this file carried was read by nothing -- and an example run, whose whole
    // point is to be safe to try, pushed a real desktop notification every time.
    "backend": "none",            // DEMO: an example run must not push a desktop notification
    "only_if": ["change", "deadline_lead", "new_stalled", "neglect", "claims_dropped"],
    "title": "Today's brief (example)"
  },

  "model_by_stage": {
    "sense": null,
    "render": null,
    "daily": { "model": "sonnet", "effort": "low" },
    "bootstrap": { "model": "opus", "effort": "high" },
    "weekly_automation": { "model": "opus", "effort": "medium" }
  },

  "external_tools": {
    // Optional by contract: absent binary means tool_missing in the snapshot, not a failed run.
    "scc": "scc"
  }
}

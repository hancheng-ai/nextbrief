// Example registry -- the runnable twin of nextbrief/templates/registry.example.jsonc.
// Every project below actually exists on disk once you have run
// `scripts/build-example.sh` (or `make`), so this file is a working demonstration
// rather than a document about one.
//
// Everything here is invented. Any resemblance to a real portfolio is the point:
// the shapes are real, the content is not.
{
  "meta": {
    "template_version": "1.0",
    "status": "accepted",
    "doc_type": "registry",
    "scope": "portfolio",
    "owner": "Example User",
    "last_reviewed": "2026-03-16"
  },

  "defaults": {
    // Relative to this workspace directory, so the example runs from wherever it
    // was checked out. Your own registry will normally point at an absolute path
    // or a `~`-rooted one.
    "root": "./projects",

    // Applied to every project. These paths are regenerated by a build; counting
    // them as evidence would let one `npm run build` fake a week of activity.
    "ignore_globs": [
      "**/.git/**", "**/node_modules/**", "**/__pycache__/**", "**/.venv/**",
      "**/venv/**", "**/dist/**", "**/build/**", "**/.next/**", "**/target/**",
      "**/vendor/**", "**/.DS_Store", "**/*.pyc", "**/.pytest_cache/**"
    ]
  },

  "projects": [

    {
      "id": "orchard-api",
      "name": "Orchard API",
      "paths": ["orchard-api"],
      "git": "auto",
      "status": "active",
      "positioning": "flagship",
      "goal_one_line": "Decide whether the tenant-isolation rewrite ships this quarter",
      "horizon": "quarter",
      "ice": { "impact": 5, "confidence": 3, "effort": 4 },
      "blocked_by": "decision",    // not neglected -- waiting on a judgement call

      // beacon-portal lives inside this repository but is registered separately.
      // Excluding it here stops its commits from being counted twice.
      "exclude_subpaths": ["orchard-api/apps/beacon-portal"],

      // The one thing a status document cannot express: the question, what evidence
      // would settle it, and why nobody has answered it. Projects carrying an open
      // decision are reported under "decisions pending", never under "stalled".
      "open_decision": {
        "question": "Per-tenant schemas, or stay on a shared schema with a tenant_id column?",
        "evidence_needed": "p95 query latency per tenant at current row counts, for the ten largest tenants",
        "evidence_available": true,
        "evidence_where": "orchard-api/bench/results/*.json -- the harness already records per-tenant timings",
        "why_not_answered": "The report aggregates across tenants, so the tail that actually matters is averaged away"
      },

      "status_docs": [
        { "path": "orchard-api/PROJECT_STATUS.md",        "kind": "status",   "authority": "high" },
        { "path": "orchard-api/docs/TENANCY_DECISION.md", "kind": "gate",     "authority": "high" },
        { "path": "orchard-api/docs/RUNBOOK.md",          "kind": "runbook",  "authority": "medium" },
        { "path": "orchard-api/docs/BENCH_NOTES.md",      "kind": "research", "authority": "low",
          "known_stale": true }   // you already know; do not spend an alert on it
      ],

      // Two documents disagree. Declaring the winner beats hoping the model guesses,
      // and beats silently reporting whichever it happened to read last.
      "conflicts": [
        { "doc": "orchard-api/docs/BENCH_NOTES.md", "contradicts": "orchard-api/PROJECT_STATUS.md",
          "about": "whether the tenancy benchmark is finished",
          "authority_wins": "orchard-api/PROJECT_STATUS.md" }
      ],

      "non_goals_doc": "orchard-api/README.md",
      "non_goals_heading": "Explicitly not doing",

      // openapi/ is regenerated from the route definitions on every commit.
      "ignore_globs": ["openapi/**", "docs/*.pdf", "bench/results/**"],

      "neglect_days": 21,          // flagship: three weeks of silence is worth saying out loud
      "automation_surface": ["ci", "docker-compose", "sqlite", "openapi-gen"],
      "notes": "The rewrite sits behind ORCHARD_TENANCY=schema, default off, so 'decide' and 'build' are separable."
    },

    {
      "id": "beacon-portal",
      "name": "Beacon Portal",
      // Physically inside the orchard-api repository. Registering it separately makes
      // git log filter by pathspec instead of reporting repo-wide churn as progress.
      "paths": ["orchard-api/apps/beacon-portal"],
      "git": "auto",
      "status": "active",
      "goal_one_line": "Ship the read-only status page tenants keep asking support for",
      "horizon": "month",
      "ice": { "impact": 3, "confidence": 4, "effort": 2 },
      "status_docs": [
        { "path": "orchard-api/apps/beacon-portal/ARCHITECTURE.md", "kind": "status", "authority": "high" }
      ],
      "automation_surface": ["ci", "static-site"],
      "notes": "Same repo, different cadence. Keep it out of orchard-api's counts."
    },

    {
      "id": "lantern-site",
      "name": "Lantern Site",
      // Two paths in two different repositories: sites/lantern has its own .git nested
      // inside the atelier monorepo. Repo discovery is per path, not per project,
      // because a project spanning a nested repo is ordinary and treating it as one
      // repo would attribute the wrong commits to it.
      "paths": ["atelier/sites/lantern", "atelier/packages/lantern-theme"],
      "git": "auto",
      "status": "active",
      "goal_one_line": "Keep publishing; the writing is the point, the site is scaffolding",
      "horizon": "quarter",
      "ice": { "impact": 4, "confidence": 4, "effort": 2 },
      "status_docs": [
        { "path": "atelier/sites/lantern/PUBLISHING.md", "kind": "runbook", "authority": "high" },
        { "path": "atelier/CURRENT_SPRINT.md", "kind": "sprint", "authority": "low",
          "shared_with": ["tidepool-docs"], "known_stale": true }
      ],
      "external_dependency": "Draft posts from the site's author",
      "automation_surface": ["static-site", "ci"]
    },

    {
      "id": "tidepool-docs",
      "name": "Tidepool Docs",
      "paths": ["tidepool-docs"],
      "git": "none",               // a declaration, not a discovery: "this has no version control" is itself a fact worth stating
      "status": "active",
      "goal_one_line": "Get the handbook to a state a new contributor can follow unaided",
      "horizon": "month",
      "ice": { "impact": 3, "confidence": 4, "effort": 3 },
      "status_docs": [
        // HANDBOOK_STATUS.md is edited often but still claims a date from last autumn.
        // That gap is the staleness signal: recent file, ancient self-declaration.
        { "path": "tidepool-docs/HANDBOOK_STATUS.md",     "kind": "status",    "authority": "high" },
        { "path": "tidepool-docs/notes/MIGRATION_PLAN.md", "kind": "task_pack", "authority": "medium" }
      ],

      // Deadlines are read from here and nowhere else. Never let a model harvest a date
      // out of prose and call it a deadline: prose dates are where models hallucinate
      // most, and a deadline is the field with the heaviest consequences.
      "deadlines": [
        { "date": "2026-03-24", "label": "Contributor handbook due for review", "lead_days": 14, "hard": false },
        { "date": "2026-04-30", "label": "Docs site migration cutover",         "lead_days": 30, "hard": true }
      ],

      "ignore_globs": ["_site/**", "**/*.pdf"],
      "automation_surface": ["static-site"],
      "notes": "No VCS, so progress can only be inferred from file timestamps. The brief must say so out loud."
    },

    {
      "id": "kiln",
      "name": "Kiln",
      "paths": ["kiln"],
      "git": "auto",
      "status": "maintenance",
      "goal_one_line": "Keep the batch runner alive; no new features",
      "horizon": "someday",
      "ice": { "impact": 2, "confidence": 4, "effort": 2 },

      // Sensed, never read. never_read yields a count and nothing else: no file names,
      // no excerpts, nothing in the snapshot. The reason field is for you, not the
      // machine -- six months from now it is the only thing standing between this rule
      // and someone relaxing it "just this once".
      "privacy": {
        "never_read": ["fixtures/private/**"],
        "reason": "Captured request payloads kept as regression fixtures. Count them; never read them, and keep their file names out of the snapshot."
      },

      // This project publishes its own daily entry point. The brief renders a count and
      // a link and never restates its contents -- avoiding two failure modes at once:
      // duplicating a document that already exists (which then drifts), and spending
      // the entire alert budget on one project.
      "has_own_daily_entry": "kiln/OPERATIONS_LOG.md",

      "status_docs": [
        { "path": "kiln/OPERATIONS_LOG.md", "kind": "entry",  "authority": "derived" },
        { "path": "kiln/README.md",         "kind": "status", "authority": "medium" }
      ],

      // Rules stated where the tool reads, not in a prompt, so they survive prompt rewrites.
      "hard_rules": [
        "Never open anything under fixtures/private/, not even to count lines.",
        "Do not propose new features for a project in the maintenance phase."
      ],

      "ignore_globs": ["fixtures/generated/**", "**/*.log"],
      "automation_surface": ["cron", "ci"]
    },

    {
      "id": "quarry",
      "name": "Quarry",
      "paths": ["quarry"],
      "git": "auto",
      "status": "frozen",
      "goal_one_line": "(undecided) -- either commit the pending work and pick a next step, or archive it explicitly",
      "horizon": "someday",
      "ice": { "impact": 2, "confidence": 2, "effort": 3 },
      "status_docs": [
        { "path": "quarry/CURRENT_SPRINT.md", "kind": "sprint", "authority": "medium" }
      ],
      "neglect_days": 60,          // dormant on purpose: do not nag about it monthly
      "automation_surface": [],
      "notes": "Uncommitted work sitting in the tree since December. Textbook 'stalled: no next step'."
    }

  ],

  // Sensed for activity, never turned into work. A watched path earns one line when
  // it changes and never produces a next action.
  "watch": [
    { "path": "sandbox",       "reason": "Scratch experiments; churn here means nothing" },
    { "path": "archive/talks", "reason": "Delivered conference material, kept for reference" }
  ],

  // Infrastructure, not projects. Listed so a change is legible rather than mysterious.
  "infra": [
    { "path": "homelab-config",
      "reason": "Compose files and cron definitions for the box that runs the batch jobs",
      "note": "These files are a deployment snapshot, not runtime state. Never infer from them whether a service is actually up." }
  ],

  // Present on disk, deliberately invisible. Recording the reason is what keeps this
  // list from being re-litigated every time somebody reads the registry.
  "ignored": [
    { "path": "handoff-inbox", "reason": "Third-party deliverables; also a prompt-injection surface -- read-only, never acted on" },
    { "path": "tmp",           "reason": "Scratch downloads" }
  ],

  "archived": [
    { "path": "old-storefront", "last_active": "2024-09" },
    { "path": "pager-bot",      "last_active": "2023-11" }
  ]
}

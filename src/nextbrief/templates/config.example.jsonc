// nextbrief configuration -- thresholds, weights, caps, model tiers. Rarely edited.
// JSONC: // and /* */ comments and trailing commas are allowed.
{
  // Output language. Any locale shipped in nextbrief/locales/ (`nextbrief locales`
  // lists them). This selects wording only; every threshold below is language-neutral.
  "locale": "en",

  // Which assistant runs the interpretation stage, and how hard it thinks.
  // Overridden per stage by model_by_stage below, when that stage names a model.
  "provider": {
    "name": "claude",
    "model": "sonnet",
    "effort": "low"
  },

  "schedule": {
    "slot": "21:30",              // intended run time, local clock
    "late_warn_minutes": 360      // running this much later than the slot -> banner in the brief, and the activity windows are recomputed
  },

  "signal": {
    // Activity tiers, decided purely by "days since the most recent evidence".
    // This has to be a threshold function. If a model judges it, the same facts
    // get a different word on different days, and you stop trusting the word.
    "hot_days": 3,
    "warm_days": 10,
    "cold_days": 30,
    // Staleness: how far a document's self-declared date ("> Last updated:" /
    // "last_reviewed:") may lag the newest real evidence before it is called stale.
    "stale_threshold_days": 21,
    // Activity windows, in days.
    "windows": [1, 7, 30]
  },

  "evidence": {
    // Confidence order: a commit is the strongest signal, a document's own claim
    // about itself the weakest. The brief must name the kind of signal --
    // "76 files touched (file timestamps; this project has no VCS)" and
    // "178 commits" should not read the same.
    // `probe` sits under `session` on purpose. It is a real observation of the
    // outside world, but it is the only kind that is not on this machine, so it
    // is the only one the reader cannot go and check.
    "confidence_order": ["commit", "session", "probe", "file_mtime", "doc_declared",
                         "human", "none"],
    // kind: none may only be phrased this one way. Having exactly one sentence for
    // "nothing happened" is what stops absence from being dressed up as a finding.
    "none_allowed_pattern": "no signal"
  },

  // External probes -- see `evidence_probe` in registry.jsonc.
  //
  // ★ These settings are read by `nextbrief probe` and by nothing else. `sense`
  //   never opens a socket: it reads state/probes.json, which this command
  //   writes. That separation is deliberate and is covered by a test.
  "probe": {
    // How long a reading stays current. Past this the brief keeps printing the
    // number -- it is still the best fact available -- but prints its age next
    // to it and suggests re-sampling. A number that does not say how old it is
    // is indistinguishable from prose somebody typed once and forgot.
    "ttl_days": 7,
    // Per request. A probe that hangs must not hold up the person who ran it.
    "timeout_seconds": 10
  },

  "scoring": {
    // score = 8*I + U + E    -- added, never multiplied.
    //
    //   I  the impact ordinal, 1..4, from the one question `review` asks.
    //   U  an urgency step, 0 or 8, only inside a dated commitment's lead
    //      window. A cliff and not a ramp: cost of delay on a fixed date is
    //      zero until the latest start, so a days-remaining term would raise
    //      every dated project every morning with no new evidence.
    //   E  an evidence tie-break in -3..+3 over sensed activity, and nothing
    //      more. Commit volume is sunk cost; scoring on it makes the brief a
    //      mirror that tells you to work on what you are already working on.
    //
    // Multiplying was the previous design and the reason for this one: a decay
    // term spanning 40x destroyed a 4x impact input, so `impact 4 x 0.025` lost
    // to `impact 1 x 1.0` ten to one. Adding bounds each term by construction --
    // E alone can never cross a band, U + E crosses exactly one and never two.
    //
    // `impact` is the only part of `ice` the score reads. `confidence` and
    // `effort` still parse and are ignored: keeping them live meant a registry
    // that declared all three scored by a different rule than one answered
    // through `review`, and an ordering with two definitions is not an ordering.
    //
    // Nothing here is tunable, deliberately. Every number above is load-bearing
    // for the band arithmetic, and a config key that lets you break a proof is
    // not a setting.
    //
    // `status` no longer weights the score. It GATES: only an active project is
    // ranked, and the rest are listed with their phase said out loud. A frozen
    // flagship should not lose a numeric contest to an active experiment,
    // because "we have deliberately stopped this" is not a weaker form of "this
    // matters" -- and `positioning` sets expected dormancy rather than entering
    // the score at all.
  },

  "neglect": {
    // "Neglected" alert: an active project with zero evidence for this long.
    // Only `status: active` can earn the verdict -- `maintenance` is the
    // declaration that a project is meant to be quiet.
    "default_days": 30
    // A project with an open decision goes under "decisions pending" rather than
    // "neglected", always. Calling a deliberate pause procrastination is how the
    // whole system loses your trust, so it is behaviour rather than a setting.
  },

  "caps": {
    // Caps are enforced by the renderer, not by asking the model politely.
    // A "please be concise" instruction degrades; a renderer that truncates does not.
    "max_next_actions": 3,        // across the WHOLE portfolio, not per project. N projects x 5 items is how these systems die
    "max_waiting_for": 5,
    "max_agent_queue": 3,
    "max_new_items_per_run": 5,   // overflow goes to log/deferred.jsonl, never straight into backlog
    "max_decision_pending": 3,

    // How many "only you can answer this" questions the brief may carry.
    // Two: enough that the backlog of unanswered projects drains in a fortnight,
    // few enough that the section never competes with the actual brief.
    "max_questions": 2,
    "per_project_line_chars": 140,
    // The hard ceiling. Overflow drops WHOLE sections, least valuable first, so a
    // crowded day loses a section and says so rather than stopping mid-table --
    // and the footer is added after the cut, so the line naming what generated
    // this never disappears. The full data is always in state/snapshot.json.
    "brief_max_lines": 100
  },

  "limits": {
    "max_open_items_total": 40,   // hard ceiling. At the ceiling, no new items may be created that day, and the brief says so
    "max_open_per_project": 5
  },

  "decay": {
    // Automatic withdrawal applies only to the agent's own unconfirmed proposals.
    // An agent may retract its guesses. It may never retract your commitments.
    "auto_drop_after_days": 60,
    "auto_drop_requires": {
      "created_by_prefix": "nextbrief-",
      "human_confirmed": false,
      "zero_project_evidence": true
    }
  },

  "defer": {
    // `nextbrief defer <id> --until ...` takes either a date or the thing you are
    // waiting on. A condition cannot fire, so an item deferred on one is given a
    // date as well and comes back after this many days to be looked at again.
    // There is no "off": a deferral that never returns is a drop nobody recorded,
    // and that is the one outcome the command exists to prevent.
    "review_after_days": 30
  },

  "automation": {
    // Three rungs: explore (agent probes) -> skill (reusable, still judged by a model)
    // -> hook (deterministic, fires on its own). Promotion depends on VARIANCE, not on
    // repetition count: identical steps every time -> hook; same steps but the decision
    // moves -> skill; the decision itself not yet understood -> stay in explore.
    "tiers": ["explore", "skill", "hook"]
  },

  "notify": {
    // Where the notification goes. "auto" prefers cc-notify where it is
    // installed, then the platform default, and degrades to no notification
    // rather than failing the run.
    //
    // cc-notify posts under this tool's OWN identity. macOS draws a banner's
    // icon and its Notification Center grouping from the sending app, so every
    // tool shelling out to a bare terminal-notifier shares one identity and
    // piles into one group -- a nightly brief landing in with "session needs
    // your permission". https://github.com/hancheng-ai/cc-notify
    "backend": "auto",            // auto | none | cc-notify | macos | libnotify
    // Only if it lives somewhere the search does not look; normally omitted.
    // "cc_notify_path": "~/.claude/hooks/notify.py",
    // Silence rules. A system that tells you on time every day that nothing
    // happened gets muted in week three.
    //
    // These five are what `should_notify` implements, and nothing else is
    // accepted -- a name it does not know is simply never true, which is silence
    // where you asked for noise.
    "only_if": ["change", "deadline_lead", "new_stalled", "neglect", "claims_dropped"],
    "title": "Today's brief"
  },

  // Measured, running the same digest three times:
  //   36 turns / reading each backlog file + reading a 104KB snapshot twice ... $4.37
  //   9 turns  / reading digest.json (25KB) ............................. $1.09
  //   6 turns  / digest + effort=low ..................................... see log/runs.jsonl
  // The lesson: cache reads scale as turns x context size, and most output tokens are
  // reasoning. For "summarise a set of precomputed facts into a fixed structure",
  // high effort buys almost nothing.
  "model_by_stage": {
    "sense": null,                          // no model at all
    "render": null,                         // no model at all
    "daily": { "model": "sonnet", "effort": "low" },
    "bootstrap": { "model": "opus", "effort": "high" },
    "weekly_automation": { "model": "opus", "effort": "medium" }
  },

  "external_tools": {
    // Always optional: if the binary is absent, record tool_missing and carry on.
    "scc": "scc"                  // lines of code + cyclomatic complexity, sub-second, zero tokens
  }
}

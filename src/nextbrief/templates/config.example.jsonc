// nextbrief configuration -- thresholds, weights, caps, model tiers. Rarely edited.
// JSONC: // and /* */ comments and trailing commas are allowed.
{
  // Output language. Any locale shipped in nextbrief/locales/ (`nextbrief locales`
  // lists them). This selects wording only; every threshold below is language-neutral.
  "locale": "en",

  // Which assistant runs the interpretation stage, and how hard it thinks.
  // Overridden per stage by model_by_stage below, when that stage names a model.
  "provider": {
    "name": "claude",
    "model": "sonnet",
    "effort": "low"
  },

  "schedule": {
    "slot": "21:30",              // intended run time, local clock
    "tz_offset_hours": 0,         // your UTC offset; the scheduler must not depend on system tz naming
    "late_warn_minutes": 360      // running this much later than the slot -> banner in the brief, and the activity windows are recomputed
  },

  "signal": {
    // Activity tiers, decided purely by "days since the most recent evidence".
    // This has to be a threshold function. If a model judges it, the same facts
    // get a different word on different days, and you stop trusting the word.
    "hot_days": 3,
    "warm_days": 10,
    "cold_days": 30,
    // Staleness: how far a document's self-declared date ("> Last updated:" /
    // "last_reviewed:") may lag the newest real evidence before it is called stale.
    "stale_threshold_days": 21,
    // Activity windows, in days.
    "windows": [1, 7, 30]
  },

  "evidence": {
    // Confidence order: a commit is the strongest signal, a document's own claim
    // about itself the weakest. The brief must name the kind of signal --
    // "76 files touched (file timestamps; this project has no VCS)" and
    // "178 commits" should not read the same.
    "confidence_order": ["commit", "session", "file_mtime", "doc_declared", "human", "none"],
    // kind: none may only be phrased this one way. Having exactly one sentence for
    // "nothing happened" is what stops absence from being dressed up as a finding.
    "none_allowed_pattern": "no signal"
  },

  "scoring": {
    // score = (impact*confidence/effort) * (floor + (1-floor)*0.5^(days/half_life))
    //         * deadline_boost * tier_weight
    "half_life_days": 21,
    "decay_floor": 0.3,           // the floor exists because pure decay buries exactly the work you are avoiding
    "tier_weight": {
      "flagship": 1.3,
      "active": 1.0,
      "maintenance": 0.6,
      "dormant": 0.4
    },
    "deadline_boost_max": 3.0
  },

  "neglect": {
    // "Neglected" alert: a flagship/active project with zero evidence for this long.
    "default_days": 30,
    "renotify_days": 7,           // once a week, not once a day
    // A project with an open decision goes under "decisions pending", not "neglected".
    // Calling a deliberate pause procrastination is how the whole system loses your trust.
    "exclude_when_blocked_by_decision": true
  },

  "caps": {
    // Caps are enforced by the renderer, not by asking the model politely.
    // A "please be concise" instruction degrades; a renderer that truncates does not.
    "max_next_actions": 3,        // across the WHOLE portfolio, not per project. N projects x 5 items is how these systems die
    "max_waiting_for": 5,
    "max_agent_queue": 3,
    "max_new_items_per_run": 5,   // overflow goes to log/deferred.jsonl, never straight into backlog
    "max_decision_pending": 3,

    // How many "only you can answer this" questions the brief may carry.
    // Two: enough that the backlog of unanswered projects drains in a fortnight,
    // few enough that the section never competes with the actual brief.
    "max_questions": 2,
    "per_project_line_chars": 140,
    "brief_max_lines": 60
  },

  "limits": {
    "max_open_items_total": 40,   // hard ceiling. At the ceiling, no new items may be created that day, and the brief says so
    "max_open_per_project": 5
  },

  "decay": {
    // Automatic withdrawal applies only to the agent's own unconfirmed proposals.
    // An agent may retract its guesses. It may never retract your commitments.
    "auto_drop_after_days": 60,
    "auto_drop_requires": {
      "created_by_prefix": "nextbrief-",
      "human_confirmed": false,
      "zero_project_evidence": true
    }
  },

  "automation": {
    // Three rungs: explore (agent probes) -> skill (reusable, still judged by a model)
    // -> hook (deterministic, fires on its own). Promotion depends on VARIANCE, not on
    // repetition count: identical steps every time -> hook; same steps but the decision
    // moves -> skill; the decision itself not yet understood -> stay in explore.
    "tiers": ["explore", "skill", "hook"],
    "recheck_days": 30,
    "recheck_budget_per_run": 2
  },

  "drift": {
    "renotify_days": 14           // how long a stale/contradictory document stays quiet after being reported once
  },

  "notify": {
    // Where the notification goes. "auto" picks the first sink that works on this
    // machine and degrades to no notification rather than failing the run.
    "sink": "auto",               // auto | none | <named sink>
    // Silence rules. A system that tells you on time every day that nothing happened
    // gets muted in week three.
    "only_if": ["change", "deadline_lead", "new_stalled", "neglect", "decision_pending_new"],
    "title": "Today's brief"
  },

  "cost": {
    "alert_usd_7d": 3.0
  },

  // Measured, running the same digest three times:
  //   36 turns / reading each backlog file + reading a 104KB snapshot twice ... $4.37
  //   9 turns  / reading digest.json (25KB) ............................. $1.09
  //   6 turns  / digest + effort=low ..................................... see log/runs.jsonl
  // The lesson: cache reads scale as turns x context size, and most output tokens are
  // reasoning. For "summarise a set of precomputed facts into a fixed structure",
  // high effort buys almost nothing.
  "model_by_stage": {
    "sense": null,                          // no model at all
    "render": null,                         // no model at all
    "daily": { "model": "sonnet", "effort": "low" },
    "bootstrap": { "model": "opus", "effort": "high" },
    "weekly_automation": { "model": "opus", "effort": "medium" }
  },

  "external_tools": {
    // Always optional: if the binary is absent, record tool_missing and carry on.
    "scc": "scc",                 // lines of code + cyclomatic complexity, sub-second, zero tokens
    "ccusage": "ccusage"          // token spend, read from local logs
  }
}
